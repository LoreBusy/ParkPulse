rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User personal profiles, settings, and vehicle data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.email is string;
      allow update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);

      // User saved favorites subcollection
      match /favorites/{favId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    // Community Leaderboard (Read-accessible to authenticated users, write restricted to the owner)
    match /leaderboard/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.points is int;
      allow delete: if isOwner(userId);
    }

    // Crowdsourced parking availability & departure reports
    match /parking_reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.reportId == reportId
        && request.resource.data.areaId is string
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
      allow update: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmations', 'status']));
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Real-time city emergency traffic & street closure alerts
    match /traffic_incidents/{incidentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && request.resource.data.incidentId == incidentId
        && request.resource.data.title is string;
      allow delete: if isAuthenticated();
    }

    // Tamper-proof Security & Anti-Fraud Audit Logs
    match /security_audit_logs/{logId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.action is string;
      allow update, delete: if false; // Immutable audit log
    }
  }
}
